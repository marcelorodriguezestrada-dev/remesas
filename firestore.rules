rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /operaciones/{operacionId} {
      // Cualquiera puede crear una operación: es el cliente público
      // usando el cotizador, todavía no está logueado ni tiene por qué
      // estarlo.
      allow create: if true;

      // Pero leer la lista completa, actualizar el estado o borrar
      // operaciones solo lo puede hacer quien esté autenticado (vos,
      // desde /admin).
      allow read, update, delete: if request.auth != null;
    }

    match /competencia/{observacionId} {
      // Los precios de competencia son 100% privados: solo un usuario
      // autenticado puede leerlos o cargarlos.
      allow read, write: if request.auth != null;
    }

    match /historial_tasas/{snapshotId} {
      // Lo escribe nuestro propio servidor cada vez que alguien consulta
      // /api/tasas (llamada anónima, sin sesión de usuario) — por eso
      // el escritura es pública. La lectura del histórico completo sí
      // queda solo para el admin logueado.
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /visitas/{visitaId} {
      // Las escribe cualquier visitante anónimo de la página pública
      // (para trackear UTM); solo el admin logueado ve el listado.
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /publicaciones_marketing/{publicacionId} {
      // La ESCRITURA la hace nuestro propio servidor (sin sesión de
      // usuario): tanto el cron diario (protegido por CRON_SECRET a nivel
      // de API) como el botón "Publicar ahora". La LECTURA en cambio se
      // hace siempre desde el navegador del admin ya logueado (nunca
      // desde una ruta de servidor sin sesión) — si alguna vez se lee
      // esta colección desde un endpoint de servidor, esa lectura va a
      // fallar acá porque no hay request.auth en ese contexto.
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /articulos_mercado/{articuloId} {
      // Cualquiera (visitante anónimo, o el propio servidor renderizando
      // /analisis para SEO) puede leer un artículo YA publicado. Los
      // borradores (publicado == false) solo los puede leer el admin
      // logueado, y siempre se leen desde el navegador (ver /admin/analisis).
      allow read: if resource.data.publicado == true || request.auth != null;
      // Crear/editar/borrar SIEMPRE desde el navegador del admin logueado
      // (no hay ninguna ruta de servidor que escriba acá).
      allow write: if request.auth != null;
    }

    match /vistas_articulos/{slugArticulo} {
      // Lo incrementa cualquier visitante anónimo que entra a un
      // artículo (ver TrackerVistaArticulo) — por eso la escritura es
      // pública, igual que historial_tasas/visitas. Solo el admin
      // logueado puede leer el conteo total (se muestra en /admin/analisis).
      allow read: if request.auth != null;
      allow write: if true;
    }
  }
}
